{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "CommonJS",
    "types": ["node"]
  },
  "include": [
    "electron/browser/**/*.cjs",
    "electron/translation/**/*.cjs"
  ]
}
