{
  "name": "site-nest-desktop",
  "productName": "栖页",
  "version": "0.5.5",
  "description": "多空间、本地优先的网页工作台",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "lint": "node scripts/lint.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "check:syntax": "node scripts/check-syntax.cjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:unit": "node --test test/unit/*.test.cjs",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.cjs",
    "audit:ui-actions": "node scripts/audit-ui-actions.cjs --strict",
    "test": "npm run test:unit && npm run test:integration",
    "dev": "electron .",
    "start:prod-local": "electron . --prod-local",
    "start": "npm run dev",
    "build:code": "node scripts/check-syntax.cjs",
    "build": "npm run build:code",
    "package:portable": "electron-builder --win portable --x64",
    "package:win": "electron-builder --win nsis --x64",
    "release": "npm run check && npm run package:portable"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "local.qiye.sitehub",
    "productName": "栖页",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "!release/**/*"
    ],
    "win": {
      "icon": "assets/app-icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "栖页-${version}-便携版.${ext}"
    }
  }
}
